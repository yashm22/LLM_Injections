# Obtain this from your OpenAI project settings. Never commit your real key.
OPENAI_API_KEY=
# Pin this to the model your application uses.
# Cost-efficient default for large test suites. Set to gpt-5.6-sol for the
# flagship model, or set this to the exact model used by your application.
OPENAI_MODEL=gpt-5.6-luna

# Ollama runs locally and needs no API key. First install Ollama, then download
# the model once with: ollama run qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
